# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub (está no .gitignore).
# Nunca cole a chave no código nem em mensagens/chat.

# Chave da API da OpenAI (platform.openai.com > API keys). O SDK da OpenAI lê este nome automaticamente.
OPENAI_API_KEY=

# Modelo de cada agente (escolhidos pelo teste em docs/escolha_modelos.md, 23/11/2026)
MODELO_ORQUESTRADOR=gpt-6.1-terra
MODELO_SQL=gpt-6.2-sol
MODELO_ANALISTA=gpt-6-luna

# Esforço de raciocínio por agente (low | medium | high) — opcional, estes são os padrões do src/llm.py
ESFORCO_ORQUESTRADOR=low
ESFORCO_SQL=medium
ESFORCO_ANALISTA=low

# Cache em disco das respostas da LLM: 1 = ligado (SÓ no desenvolvimento, economiza créditos);
# 0 = desligado (OBRIGATÓRIO nas medições oficiais do golden set: tempo e custo precisam ser reais)
LLM_CACHE=0

# Banco de dados (somente leitura)
DB_PATH=data/processed/combustiveis.duckdb
